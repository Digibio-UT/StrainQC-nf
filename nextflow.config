/*
 * StrainQC-nf — Nextflow re-platform of the StrainQC / Contamination Detection Platform.
 * Portable per-site deployment (DTU Strategy 3): runs on UT HPC (Slurm), Seqera, or cloud.
 * Tower-COMPATIBLE but not Tower-DEPENDENT (plain nf-core-style).
 */

manifest {
    name            = 'StrainQC-nf'
    author          = 'DTU + UT DigiBio'
    description     = 'Sequencing-based strain QC: variant calling (breseq / GATK) + contamination detection'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'          // process.resourceLimits
    version         = '0.2.0'
}

params {
    // ── I/O ──────────────────────────────────────────────────────────
    input          = null            // samplesheet CSV (see assets/samplesheet.example.csv)
    reference      = null            // reference genome .gbk/.gb/.fasta/.fa/.fna
    outdir         = 'results'

    // ── Variant calling ──────────────────────────────────────────────
    variant_caller    = 'breseq'     // 'breseq' | 'gatk'
    polymorphism_mode = false        // breseq -p  /  GATK Mutect2 instead of HaplotypeCaller
    ploidy            = 1            // GATK HaplotypeCaller only (1 = haploid bacteria, 2 = diploid yeast)

    // ── Copy-number / aneuploidy (CNVkit, gatk path) ─────────────────────
    // Set to the sample id of the un-evolved ancestor to enable cohort CNV calling: its
    // coverage becomes the CNVkit reference and every other sample is called against it
    // (evolved-vs-parent, à la Ottilie et al. 2022). null → CNV step skipped entirely.
    parent_sample     = null

    // breseq advanced knobs (mirror backend/app/pipeline/wrappers.py: run_breseq)
    breseq_limit_fold_coverage           = 0
    breseq_base_quality_cutoff           = 3
    breseq_min_mapping_quality           = 0
    breseq_polymorphism_frequency_cutoff = 0.05
    breseq_no_junction_prediction        = false
    breseq_consensus_min_cov_each_strand = 0
    breseq_targeted_sequencing           = false

    // GATK advanced knobs (mirror run_gatk_haplotype_caller / run_gatk_mutect2)
    gatk_min_base_quality        = 10
    gatk_min_mapping_quality     = 20
    gatk_max_reads_per_align_start = 50
    gatk_dont_use_soft_clipped   = false
    gatk_call_conf               = 30.0   // HaplotypeCaller only
    gatk_callable_depth          = 10     // Mutect2 only

    // ── Reference databases (staged per-site; see README "Setup") ─────
    kraken2_db = null                // dir; contamination screen. null → skip / BLAST fallback
    mash_db    = null                // refseq.msh; containment screen
    run_blast  = false               // remote BLASTN fallback (slow, needs internet)

    // ── Evidence / coverage pre-compute (avoids cloud egress at view-time) ──
    evidence_window    = 75
    evidence_max_reads = 80
    coverage_resolution = 2000

    // ── HPC tool provisioning via environment modules (the `hpc_modules` profile) ──
    // Replicates the working SlurmApp's proven activation (conda env + modules). Applied
    // as a per-process beforeScript. Override wholesale if your env/module names differ:
    //   nextflow run . -profile test,hpc_modules --hpc_pre_command 'module load ...'
    hpc_pre_command = 'module load miniconda3 ; module load breseq ; eval "$(conda shell.bash hook)" ; conda activate bio-platform ; module load gatk/4.4.0.0 bwa-mem2/2.2.1'

    // Slurm submission (UT HPC / ETAIS). Account is mandatory here. Override per allocation:
    //   nextflow run . -profile test,slurm,hpc_modules --hpc_account <acct> --hpc_queue <partition>
    hpc_account = 'ealloc_bioeng_h-1'
    hpc_queue   = 'main'

    // ── Resource ceilings ────────────────────────────────────────────
    max_cpus   = 16
    max_memory = '64.GB'
    max_time   = '48.h'

    // ── Container image (Approach 1: one all-in-one image for every process) ──
    // Contains all tools (samtools, bwa-mem2, gatk4, breseq, kraken2, mash, blast, python).
    // Build it as an Apptainer SIF on the HPC (see containers/strainqc.def + containers/README.md)
    // and point here, e.g.:
    //   -profile apptainer --strainqc_container /gpfs/.../containers/strainqc.sif
    // A docker:// URI works too once the image is pushed to a registry.
    // Only used when a container engine is enabled (apptainer/docker); ignored under hpc_modules.
    strainqc_container = 'strainqc.sif'
}

// ── Execution profiles: the layer that replaces worker.py + slurm_runner.py ──
// Compose them: `-profile test,apptainer` (local smoke) or `-profile hpc` (Slurm+Apptainer).
profiles {
    standard   { process.executor = 'local' }
    docker     { docker.enabled = true;      docker.runOptions = '-u $(id -u):$(id -g)' }
    conda      { conda.enabled = true }

    // Container runtimes. UT HPC has Apptainer 1.4.1 (module load apptainer).
    // Nextflow's apptainer scope pulls docker:// images and converts to SIF.
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        // Cache SIFs outside work/ so they're reused across runs. Override with
        // NXF_APPTAINER_CACHEDIR, or edit here. Must be on a filesystem the compute nodes see.
        apptainer.cacheDir   = "${System.getenv('NXF_APPTAINER_CACHEDIR') ?: "$projectDir/.apptainer"}"
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.cacheDir   = "${System.getenv('NXF_SINGULARITY_CACHEDIR') ?: "$projectDir/.singularity"}"
    }

    // UT HPC (rocket, RHEL9) — replaces the hardcoded sbatch/ssh/paramiko path.
    // TODO: confirm partition/queue + account with Vallo/Hamza before heavy runs.
    slurm {
        process.executor       = 'slurm'
        process.queue          = params.hpc_queue
        process.clusterOptions = "--account=${params.hpc_account}"
    }

    // Tool provisioning via `module load` (no containers) — the fast, proven path that
    // reuses SlurmApp's working stack. COMPOSE with an executor profile:
    //   -profile test,hpc_modules          # run on the login node (local executor)
    //   -profile test,slurm,hpc_modules    # submit each process as a Slurm job
    // Multi-tool processes work because the beforeScript loads the whole env.
    hpc_modules {
        process.beforeScript = params.hpc_pre_command
    }

    // Convenience: the full UT HPC setup in one flag (Slurm + Apptainer).
    hpc {
        process.executor       = 'slurm'
        process.queue          = params.hpc_queue
        process.clusterOptions = "--account=${params.hpc_account}"
        apptainer.enabled      = true
        apptainer.autoMounts   = true
        apptainer.cacheDir     = "${System.getenv('NXF_APPTAINER_CACHEDIR') ?: "$projectDir/.apptainer"}"
    }

    // Cloud (AWS Batch / Azure) — fill in when a site needs it.
    // awsbatch { process.executor = 'awsbatch'; ... }

    test { includeConfig 'conf/test.config' }
}

includeConfig 'conf/base.config'

// ── Run provenance ───────────────────────────────────────────────────
timeline.enabled = true
report.enabled   = true
trace.enabled    = true
dag.enabled      = true
timeline.file = "${params.outdir}/pipeline_info/timeline.html"
report.file   = "${params.outdir}/pipeline_info/report.html"
trace.file    = "${params.outdir}/pipeline_info/trace.txt"
dag.file      = "${params.outdir}/pipeline_info/dag.html"
// Allow overwrite so re-runs don't warn "Failed to render … file already exists".
timeline.overwrite = true
report.overwrite   = true
trace.overwrite    = true
dag.overwrite      = true
