/*
 * Base resource allocation by process label.
 * Labels are attached in each module; tune here per site.
 */

process {
    cpus   = 2
    memory = 4.GB
    time   = 4.h

    // One all-in-one image for every process (Approach 1). Used only when a container engine
    // is enabled (apptainer/docker); ignored under hpc_modules (module load provides tools).
    container = params.strainqc_container

    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 1

    withLabel: process_low    { cpus = 2;  memory = 4.GB;  time = 4.h  }
    withLabel: process_medium { cpus = 4;  memory = 16.GB; time = 8.h  }
    withLabel: process_high   { cpus = 8;  memory = 32.GB; time = 16.h }

    // Remote BLAST is network-bound, not CPU-bound — 1 slot, long wall clock.
    withLabel: process_network { cpus = 1; memory = 2.GB; time = 24.h; maxForks = 1 }
}
