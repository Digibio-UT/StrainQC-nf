/*
 * Minimal test profile — small inputs for CI / smoke tests.
 * TODO: point `input`/`reference` at a tiny bundled dataset (e.g. E. coli REL606 subset).
 */
params {
    max_cpus   = 2
    max_memory = '6.GB'
    max_time   = '1.h'

    // input     = "${projectDir}/assets/test/samplesheet_test.csv"
    // reference = "${projectDir}/assets/test/REL606.gbk"
    variant_caller = 'gatk'
    ploidy         = 1
}
