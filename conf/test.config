/*
 * Test profile — tiny synthetic dataset (bin/make_testdata.py) for smoke tests / CI.
 * Expected result: exactly one SNP at CHR1:1000 (see assets/test/EXPECTED.md).
 *
 *   nextflow run . -profile test        -stub      # validate wiring, no tools
 *   nextflow run . -profile test,apptainer         # real run on HPC
 */
params {
    max_cpus   = 2
    max_memory = '6.GB'
    max_time   = '1.h'

    input     = "${projectDir}/assets/test/samplesheet.csv"
    reference = "${projectDir}/assets/test/reference.fasta"

    variant_caller = 'gatk'
    ploidy         = 1
    // No reference DBs in the test → Kraken/MASH steps report "skipped", as intended.
}
