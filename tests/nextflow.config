/*
 * Config applied on top of nextflow.config for every nf-test run (tests/main.nf.test).
 * nf-test already selects the `test` profile (nf-test.config).
 */

// Keep test runs quiet: no run-provenance HTML per test case. (Leave `trace` alone —
// nf-test reads its own trace to provide workflow.trace in the assertions.)
timeline.enabled = false
report.enabled   = false
dag.enabled      = false
